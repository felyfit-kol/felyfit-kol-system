<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.felyfit.collab-metrics</string>

  <key>WorkingDirectory</key>
  <string>/Users/lucy/Desktop/Claude Code/felyfit-kol-system</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/lucy/Desktop/Claude Code/felyfit-kol-system/.venv/bin/python</string>
    <string>/Users/lucy/Desktop/Claude Code/felyfit-kol-system/scheduled_metrics_refresh.py</string>
  </array>

  <!-- Corre 1 vez al día a las 11:00 AM (hora local del Mac).
       Si la Mac está apagada/dormida, ese día se skipea — Lucy puede
       usar el botón "Actualizar todas las collabs activas ahora" en
       Settings para hacer catch-up manual los lunes. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>11</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/lucy/Desktop/Claude Code/felyfit-kol-system/data/collab_metrics.stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/lucy/Desktop/Claude Code/felyfit-kol-system/data/collab_metrics.stderr.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
  </dict>
</dict>
</plist>
